rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Employees collection rules
    match /employees/{employeeId} {
      // Admin can read all employees
      allow read: if isAdmin();
      
      // Admin can create their own profile on first login
      allow create: if request.auth != null && 
                      request.auth.uid == employeeId &&
                      request.resource.data.isAdmin == true;
      
      // Admin can create new employees
      allow create: if isAdmin() && 
                      request.resource.data.isAdmin == false;
      
      // Employees can read their own data (for employee page)
      allow read: if request.auth == null && 
                     employeeId != null;
      
      // Admin can update employee data
      allow update: if isAdmin();
    }
    
    // Attendance collection rules
    match /attendance/{attendanceId} {
      // Admin can read all attendance records
      allow read: if isAdmin();
      
      // Employees can read their own attendance records
      allow read: if request.auth == null && 
                     resource.data.employeeId != null;
      
      // Admin can create attendance records (for themselves or employees)
      allow create: if isAdmin();
      
      // Employees can create their own attendance records
      allow create: if request.auth == null && 
                      request.resource.data.employeeId != null &&
                      request.resource.data.employeeName != null &&
                      request.resource.data.type in ['check-in', 'check-out'] &&
                      request.resource.data.timestamp != null;
      
      // Admin can update attendance records
      allow update: if isAdmin();
      
      // Admin can delete attendance records
      allow delete: if isAdmin();
    }
  }
}
